# ===================================================================
# MemoraAI Environment Variables Template (.env.example)
# Copy this file to '.env' before running docker compose or local services.
# ===================================================================

# --- PostgreSQL Configuration ---
POSTGRES_DB=memora_db
POSTGRES_USER=memora_user
POSTGRES_PASSWORD=memora_password_dev
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# --- Neo4j Graph DB Configuration ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=memora_neo4j_dev
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HOST=neo4j

# --- MinIO Object Storage Configuration ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password_dev
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_HOST=minio

# --- Qdrant Vector DB Configuration ---
QDRANT_PORT=6333
QDRANT_HOST=qdrant

# --- Microservices Configuration ---
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=ai-service
BACKEND_PORT=8080
BACKEND_HOST=backend
FRONTEND_PORT=3000

# --- Authentication & Application Settings ---
JWT_SECRET=memora_super_secret_jwt_key_2026_dev_mode
DEMO_MODE=false
LLM_PROVIDER=gemini

# --- External AI API Keys ---
# Gemini key is required when LLM_PROVIDER=gemini.
OPENAI_API_KEY=
GEMINI_API_KEY=AQ.Ab8RN6Ioh1YmNpiuti8sQPLZXx7xDCMeYJtKFudyJWmSl5DUvw
GEMINI_MODEL=gemini-3.8-flash

# --- Speech-to-Text (STT) Configuration ---
# Options: 'whisper-local' (genuine faster-whisper speech recognition) or 'mock' (simulated template)
STT_PROVIDER=whisper-local
# Multilingual Whisper model size: 'tiny', 'base', 'small' (recommended for CPU), 'medium', 'large-v3'
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
